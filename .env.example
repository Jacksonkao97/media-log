# Copy to .env.local and fill in. See README「Google Drive 同步设置」.

# Any long random string; e.g. `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Needed for `npm run build && npm start` (production mode) anywhere except
# Vercel — e.g. trying a production build locally, or self-hosting.
# `npm run dev` and Vercel don't need it.
# AUTH_TRUST_HOST=true

# Optional: movies in 发现 (TMDB). See README「新番 / 电影资讯」.
# themoviedb.org → Settings → API: the "API Read Access Token" (or the
# 32-character API key). Anime and manga (AniList) need nothing.
TMDB_API_KEY=
# Optional: whose cinema dates 正在热映 / 即将上映 follow (CN, TW, HK, US…).
# TMDB_REGION=CN
