# Copy to .env.local and fill in. See README「Google Drive 同步设置」.

# Any long random string; e.g. `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Needed for `npm run build && npm start` (production mode) anywhere except
# Vercel — e.g. trying a production build locally, or self-hosting.
# `npm run dev` and Vercel don't need it.
# AUTH_TRUST_HOST=true

# Optional: movies in 发现 (TMDB). See README「新番 / 电影资讯」.
# themoviedb.org → Settings → API: the "API Read Access Token" (or the
# 32-character API key). Anime and manga (AniList) need nothing.
TMDB_API_KEY=
# Optional: whose cinema dates 正在热映 / 即将上映 follow (CN, TW, HK, US…).
# TMDB_REGION=CN

# Optional: 更新提醒 (push notifications). See README「更新提醒」.
# `npx web-push generate-vapid-keys`; keep them once chosen (changing them
# signs every device out of reminders).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# What the scheduler sends as `Authorization: Bearer …` to /api/track/check.
CRON_SECRET=
# Storage: Upstash Redis (needed on Vercel and other serverless hosts)…
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# …otherwise a file (default .data/track.json).
# TRACK_FILE=.data/track.json
# How often each manga is re-checked, in hours (default 6).
# TRACK_MANGA_HOURS=6
# If manhuagui's www host is blocked where the server runs.
# MANHUAGUI_ORIGIN=https://tw.manhuagui.com
